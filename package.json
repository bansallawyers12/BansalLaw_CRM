{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "bansal-law-crm",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "copy:flatpickr": "node -e \"const fs=require('fs');const p='node_modules/flatpickr/dist/';fs.copyFileSync(p+'flatpickr.min.js','public/js/flatpickr.min.js');fs.copyFileSync(p+'flatpickr.min.css','public/css/flatpickr.min.css')\"",
        "copy:intl-tel-input": "node -e \"const fs=require('fs');const path=require('path');const src='node_modules/intl-tel-input/dist/';const copy=(from,to)=>{fs.mkdirSync(path.dirname(to),{recursive:true});fs.copyFileSync(from,to);};copy(src+'js/intlTelInput.min.js','public/js/intlTelInput.js');copy(src+'css/intlTelInput.min.css','public/css/intlTelInput.css');['flags.webp','flags@2x.webp','flags.png','flags@2x.png'].forEach(f=>copy(src+'img/'+f,'public/img/'+f));\"",
        "copy:sweetalert2": "node -e \"const fs=require('fs');const p='node_modules/sweetalert2/dist/';fs.copyFileSync(p+'sweetalert2.min.js','public/js/sweetalert2.min.js');fs.copyFileSync(p+'sweetalert2.min.css','public/css/sweetalert2.min.css')\"",
        "copy:bootstrap": "node -e \"const fs=require('fs');const p='node_modules/bootstrap/dist/';fs.copyFileSync(p+'css/bootstrap.min.css','public/css/bootstrap.min.css');fs.copyFileSync(p+'js/bootstrap.bundle.min.js','public/js/bootstrap.bundle.min.js')\"",
        "copy:chartjs": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/chart.js/dist/chart.umd.min.js','public/js/chart.umd.min.js')\"",
        "copy:datatables": "node -e \"const fs=require('fs');fs.copyFileSync('node_modules/datatables.net/js/dataTables.min.js','public/js/datatables.min.js');fs.copyFileSync('node_modules/datatables.net-bs5/js/dataTables.bootstrap5.min.js','public/js/dataTables.bootstrap5.min.js');fs.copyFileSync('node_modules/datatables.net-bs5/css/dataTables.bootstrap5.min.css','public/css/dataTables.bootstrap5.min.css')\"",
        "copy:tinymce": "node -e \"const fs=require('fs');const p='node_modules/tinymce/';fs.cpSync(p,'public/js/tinymce/js/tinymce/',{recursive:true})\"",
        "strip:app-min-jquery": "node scripts/strip-app-min-jquery.cjs",
        "strip:app-min-bootstrap-css": "node scripts/strip-app-min-bootstrap-css.cjs",
        "strip:app-min-fontawesome": "node scripts/strip-app-min-fontawesome.cjs",
        "migrate:bs4-blade-classes": "node scripts/migrate-bs4-blade-classes.cjs",
        "verify:bootstrap5": "node scripts/verify-bootstrap5.cjs",
        "verify:bootstrap-compat": "node scripts/verify-bootstrap-compat.cjs",
        "verify:intl-tel-input": "node scripts/verify-intl-tel-input.cjs",
        "verify:jquery": "node scripts/verify-jquery-load-order.cjs",
        "verify:sweetalert2": "node scripts/verify-sweetalert2.cjs",
        "verify:chartjs": "node scripts/verify-chartjs.cjs",
        "verify:upgraded-libs": "node scripts/verify-upgraded-libs.cjs",
        "copy:tom-select": "node -e \"const fs=require('fs');const p='node_modules/tom-select/dist/';fs.copyFileSync(p+'js/tom-select.complete.min.js','public/js/tom-select.complete.min.js');fs.copyFileSync(p+'css/tom-select.bootstrap5.min.css','public/css/tom-select.bootstrap5.min.css')\"",
        "copy:jquery": "node -e \"const fs=require('fs');const p='node_modules/jquery/dist/';fs.copyFileSync(p+'jquery.min.js','public/js/jquery.min.js')\"",
        "copy:toastify": "node -e \"const fs=require('fs');const p='node_modules/toastify-js/src/';fs.copyFileSync(p+'toastify.js','public/js/toastify.js');fs.copyFileSync(p+'toastify.css','public/css/toastify.css')\"",
        "copy:fontawesome": "node -e \"const fs=require('fs');const p='node_modules/@fortawesome/fontawesome-free/';fs.copyFileSync(p+'css/all.min.css','public/css/fontawesome.min.css');fs.cpSync(p+'webfonts','public/webfonts',{recursive:true})\"",
        "postinstall": "npm run copy:flatpickr && npm run copy:intl-tel-input && npm run copy:sweetalert2 && npm run copy:bootstrap && npm run copy:chartjs && npm run copy:tinymce && npm run copy:datatables && npm run copy:tom-select && npm run copy:jquery && npm run copy:toastify && npm run copy:fontawesome && npm run strip:app-min-jquery && npm run strip:app-min-bootstrap-css && npm run strip:app-min-fontawesome",
        "update": "npm update && npm run postinstall"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.2",
        "alpinejs": "^3.15.3",
        "axios": "^1.11.0",
        "jquery": "3.7.1",
        "jsdom": "^29.1.1",
        "laravel-vite-plugin": "^3.1.0",
        "tailwindcss": "^4.3.2",
        "vite": "^8.0.16"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.0",
        "@fullcalendar/core": "^6.1.20",
        "@fullcalendar/daygrid": "^6.1.20",
        "@fullcalendar/interaction": "^6.1.20",
        "@fullcalendar/list": "^6.1.20",
        "@fullcalendar/timegrid": "^6.1.20",
        "bootstrap": "^5.3.7",
        "chart.js": "^4.5.1",
        "datatables.net": "^2.3.8",
        "datatables.net-bs5": "^2.3.8",
        "flatpickr": "^4.6.13",
        "intl-tel-input": "^29.1.2",
        "signature_pad": "^5.1.1",
        "sweetalert2": "^11.26.25",
        "tinymce": "^8.7.0",
        "toastify-js": "^1.12.0",
        "tom-select": "^2.6.2"
    }
}
