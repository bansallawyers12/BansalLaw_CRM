APP_NAME="Bansal Law CRM"
LOGIN_BRAND="Bansal Lawyers CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Australia/Melbourne

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bansal_law_crm
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=null
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=30

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=ses
CRM_SYSTEM_MAILER=ses
CRM_PERSONAL_MAILER=zoho
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_PASSWORD=
ZOHO_SMTP_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=

CELLCAST_API_KEY=
CELLCAST_SENDER_ID=

PYTHON_SERVICE_URL=http://localhost:5002
# Optional legacy alias for PYTHON_SERVICE_URL (same python_services process)
# PYTHON_CONVERTER_URL=http://localhost:5002

RECAPTCHA_SITE_KEY=
RECAPTCHA_SITE_SECRET=

CRM_ACCESS_EXEMPT_ROLE_IDS=1,17
CRM_ACCESS_EXEMPT_STAFF_IDS=
CRM_ACCESS_QUICK_ONLY_ROLE_IDS=14
CRM_ACCESS_STRICT_ALLOCATION=false
CRM_ACCESS_ALLOCATION_ENABLED=true
CRM_ACCESS_QUICK_GRANT_MINUTES=15
CRM_ACCESS_SUPERVISOR_GRANT_HOURS=24

SUPERADMIN_BOOTSTRAP_EMAIL=admin1@gmail.com
SUPERADMIN_BOOTSTRAP_PASSWORD=

# Zoho IMAP inbox sync — memory and batch limits (especially important for CLI/cron)
MAIL_INBOX_SYNC_ENABLED=true
MAIL_MEMORY_LIMIT=1G
MAIL_SYNC_MAX_MESSAGES=10
MAIL_SYNC_MAX_INCREMENTAL_BATCHES=3
MAIL_SYNC_INITIAL_BACKFILL_MULTIPLIER=2
MAIL_SYNC_RANGE_MULTIPLIER=2
MAIL_SYNC_AUTO_CATCHUP_ENABLED=true
MAIL_SYNC_SCHEDULE_MINUTES=5

# Optional: absolute path to Python for mail sync scripts (null/empty = auto-detect when MAIL_AUTO_DETECT_PYTHON=true)
MAIL_PYTHON_EXECUTABLE=
MAIL_AUTO_DETECT_PYTHON=true

# Firm mailbox domains used for inbox matching / auto-assignment (comma-separated). Do not include client domains.
APP_FIRM_EMAIL_DOMAINS=@bansallawyers.com.au,@bansaleducation.com.au
APP_PUBLIC_EMAIL=admin@bansallawyers.com.au
APP_INVOICE_EMAIL=admin@bansallawyers.com.au
APP_PUBLIC_WEBSITE_URL=https://www.bansallawyers.com.au

# Communication Check (screenshot audit). Super Admin always; others need staff grant.
# Set true on servers where the feature should be available.
COMMUNICATION_CHECK_ENABLED=false
# Vision provider: openai (default), gemini, or auto
COMMUNICATION_CHECK_VISION_PROVIDER=openai
COMMUNICATION_CHECK_VISION_MODEL=gpt-4o-mini
# OPENAI_API_KEY=   # required for openai / auto with OpenAI key (also legal forms)
# GEMINI_API_KEY=   # used when provider=gemini or auto without OpenAI

# Legal Forms (client tab list + AI scope generation)
# LEGAL_FORMS_LIST_PER_PAGE=20
# Default sync + afterResponse: AI finishes after JSON response (no worker required)
# LEGAL_FORMS_AI_QUEUE_CONNECTION=sync
# LEGAL_FORMS_AI_AFTER_RESPONSE=true
# LEGAL_FORMS_AI_TIMEOUT=120
# LEGAL_FORMS_AI_POLL_MAX_ATTEMPTS=60
